# Copy to .env and fill in. Never commit .env.

# Postgres connection (direct, not through the pooler). Local Supabase:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55322/postgres

# Secret in Traccar's per-group forward.url path:
#   https://<engine>/v1/traccar/positions/<TRACCAR_FORWARD_SECRET>
# At least 32 characters; generate with: openssl rand -hex 32
TRACCAR_FORWARD_SECRET=

PORT=8080
# HOST=0.0.0.0

# Optional overrides (defaults in src/config.ts):
# CACHE_RELOAD_SECONDS=300
# SCHEDULER_INTERVAL_SECONDS=3600
# TICK_SECONDS=30
# LOG_LEVEL=info
