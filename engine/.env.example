# Copy to .env and fill in. Never commit .env.

# Postgres connection (direct, not through the pooler). Local Supabase:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55322/postgres

# Secret in Traccar's per-group forward.url path:
#   https://<engine>/v1/traccar/positions/<TRACCAR_FORWARD_SECRET>
# At least 32 characters; generate with: openssl rand -hex 32
TRACCAR_FORWARD_SECRET=

PORT=8080
# HOST=0.0.0.0

# Optional overrides (defaults in src/config.ts):
# CACHE_RELOAD_SECONDS=300
# SCHEDULER_INTERVAL_SECONDS=3600
# TICK_SECONDS=30
# LOG_LEVEL=info

# Arrival alerts (FCM HTTP v1, Firebase project buspilot-84a51). Without a
# service account, the engine runs and logs that alerts are off.
# Service account key: Firebase console → Project settings → Service accounts →
# Generate new private key. Keep the file on the engine host only (chmod 600),
# outside the repository; never commit it. Set ONE of:
# FCM_SERVICE_ACCOUNT_FILE=/etc/buspilot/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FCM_PROJECT_ID=buspilot-84a51     # default: project_id of the service account
# FCM_TARGET=fid                    # fid (Firebase Installation ID, default) or token
# ALERT_DELAY_MINUTES=10            # "running late" alert threshold; 0 = off
# SUBSCRIPTION_RELOAD_SECONDS=60

# Live API for the rider app and public pages. Members' access tokens are
# verified with the project's signing keys (JWKS). Without SUPABASE_URL,
# /v1/live/... answers 503; /v1/public/... works.
SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_JWT_ISSUER=http://127.0.0.1:55321/auth/v1   # default: <SUPABASE_URL>/auth/v1
# LIVE_RELOAD_SECONDS=60
# LIVE_MAX_AGE_SECONDS=300                  # members get 503 when access data is older
# LIVE_CLIENT_IP_HEADER=CF-Connecting-IP    # only behind that proxy; enables the per-IP stream limit
# LIVE_STREAMS_PER_IP=20
# LIVE_STREAMS_MAX=2000
# LIVE_STREAMS_PER_USER=4
# LIVE_HEARTBEAT_SECONDS=20
# VEHICLE_STATE_INTERVAL_SECONDS=30
